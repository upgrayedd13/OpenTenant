# ==================================================
# OpenTenant — Environment Variable Reference
# ==================================================
# Copy to:
#   .env.development
#   .env.production
# ==================================================


# --------------------------------------------------
# Application environment
# --------------------------------------------------
ENV=development
FLASK_APP=wsgi:app


# --------------------------------------------------
# Database (PostgreSQL)
# --------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev-fallback-key
POSTGRES_DB=opentenant
POSTGRES_HOST=db
POSTGRES_PORT=5432
SQLALCHEMY_TRACK_MODIFICATIONS=false


# --------------------------------------------------
# Security
# --------------------------------------------------
# MUST be overridden in production
SECRET_KEY=dev-fallback-key


# --------------------------------------------------
# Flask-Login
# --------------------------------------------------
REMEMBER_COOKIE_DURATION_DAYS=7


# --------------------------------------------------
# Logging
# --------------------------------------------------
LOG_LEVEL=INFO


# --------------------------------------------------
# Email
# --------------------------------------------------
BUG_REPORT_EMAIL=bug-report@lpmtu.com
FEEDBACK_EMAIL=feedback@lpmtu.com
CONTACT_EMAIL=contact@lpmtu.com
BOT_EMAIL=no-reply@lpmtu.com
MAIL_SERVER=mail.lpmtu.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=opentenant@lpmtu.com
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=${BOT_EMAIL}


# --------------------------------------------------
# File storage paths
# --------------------------------------------------
TMP_DIR=/tmp/OpenTenant
LEASES_DIR=/app/leases
FILE_REPOSITORY_DIR=/app/files


# --------------------------------------------------
# Upload / storage limits
# Accepts K, M, G, T suffixes
# --------------------------------------------------
MAX_CONTENT_LENGTH=10M
MAX_LEASES_DIR_SIZE=10G
MAX_FILE_REP_DIR_SIZE=10G
